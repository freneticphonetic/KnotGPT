+:root{--purple:#7d249f;--ink:#24192e;--muted:#796886;--line:#e7d9ee;--paper:#fcf8ff;--accent:#ead4f5}
+[hidden]{display:none!important}
+button,a,textarea{touch-action:manipulation}
+button{font:inherit;cursor:pointer}
+button:disabled{cursor:default;opacity:.45}
+button:focus-visible,a:focus-visible,textarea:focus-visible{outline:3px solid #a855ce;outline-offset:4px}
+.splash{height:100dvh;min-height:100svh;overflow-y:auto!important;padding:24px 16px 36px}
+.stage{width:min(92vw,620px);gap:10px;transform:none}
+.logo-shell{width:min(66vw,330px)}
+.wordmark{font-size:clamp(44px,8vw,66px)}
+.tagline{font-size:16px;margin:4px 0 12px}
+.load-panel{width:min(100%,390px);text-align:center;margin-top:10px}
+.load-panel h1{font-size:20px;font-weight:650;margin:0 0 10px;letter-spacing:-.04em}
+.load-panel p{font-size:14px;line-height:1.6;color:var(--muted);margin:8px 0}
+.load-panel #load-status{color:var(--ink);font-weight:650;min-height:22px}
+.load-panel .load-detail{font-variant-numeric:tabular-nums;font-size:12px;min-height:20px}
+progress{width:100%;height:7px;appearance:none;border:0;border-radius:20px;background:#dfcae9;overflow:hidden;margin:16px 0 4px}
+progress::-webkit-progress-bar{background:#dfcae9;border-radius:20px}
